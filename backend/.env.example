# ==============================================================================
# RaphaMIS Backend Service - VPS Production Environment Template
# ==============================================================================

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_PREFIX=api
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL Database Settings
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=raphamis_user
DB_PASSWORD=YourSecurePasswordHere
DB_DATABASE=raphamis_db
DB_TIMEZONE=Z
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_MAX=15
DB_CONNECT_TIMEOUT=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis Cache & Sliding-Window Rate Limiting
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=raphamis:
REDIS_TLS=false

# Rate Limiting Guard
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Cryptography & Security
JWT_SECRET=ReplaceWithSecureLongRandomBase64GeneratedSecretKeyForJWTAuth!
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
TOTP_ISSUER=RaphaMIS Healthcare

# Mail Service
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="RaphaMIS Notifications <noreply@raphamis.com>"
