<IfModule mod_rewrite.c>
RewriteEngine On

# 1. WebSocket configuration to backend (Port 3014)
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^/?(.*) "ws://127.0.0.1:3014/$1" [P,L]

# 2. Proxy API routes to NestJS backend on Port 3014
RewriteRule ^api$ http://127.0.0.1:3014/api [P,L]
RewriteRule ^api/(.*)$ http://127.0.0.1:3014/api/$1 [P,L]

# 3. Serve Frontend directly from dist directory if files exist
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.*)$ dist/$1 [L]

# 4. Fallback for Single Page App routing to dist/index.html
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
RewriteRule ^(.*)$ dist/index.html [L]

# 5. Fallback Proxy to Node frontend server on port 3000
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
