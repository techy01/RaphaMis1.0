# ==============================================================================
# RaphaMIS Enterprise Health Information Management System
# Production VPS Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3014
HOST=0.0.0.0
API_PREFIX=api
FRONTEND_URL=https://raphamis.saaslink.tech

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=https://raphamis.saaslink.tech,http://localhost:3000,http://127.0.0.1:3000

# Client-Side Vite API Endpoint (used by frontend build)
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL on VPS)
# ------------------------------------------------------------------------------
# Database dialect: 'mysql' (or 'postgres')
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=raphamis_user
DB_PASSWORD=ChangeThisToAStrongGeneratedPassword123!
DB_DATABASE=raphamis_db
DB_TIMEZONE=Z

# SECURITY MANDATE: In production, DB_SYNCHRONIZE MUST BE FALSE!
# Use schema migrations or schema.sql to manage schema changes safely.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Connection Pool Settings
DB_POOL_MAX=15
DB_CONNECT_TIMEOUT=10000

# SSL / TLS Settings for remote or managed databases
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 3. REDIS IN-MEMORY STATE & CACHE (Redis on VPS)
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=raphamis:
REDIS_TLS=false

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & BRUTE FORCE DEFENSE (Sliding Window via Redis)
# ------------------------------------------------------------------------------
# General API Endpoints: Max 100 requests per 60 seconds per IP/User
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Sensitive Endpoints (e.g., /auth/login, password reset, 2FA challenge)
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Account Lockout Threshold: Lockout duration in minutes after failed logins
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHY, SECRETS & AUTHENTICATION (Zero Trust)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=ReplaceWithSecureLongRandomBase64GeneratedSecretKeyForJWTAuth!
JWT_EXPIRES_IN=1h

# Password Hashing Cost (Bcrypt work factor: 10-14 recommended for modern hardware)
BCRYPT_SALT_ROUNDS=12

# Two-Factor Authentication TOTP Issuer string
TOTP_ISSUER=RaphaMIS Healthcare

# ------------------------------------------------------------------------------
# 7. SUPERADMIN PROVISIONING (System Bootstrap)
# ------------------------------------------------------------------------------
# These credentials are used by PM2 / NestJS on startup to guarantee
# the master system account exists. Do NOT lose this email.
SUPERADMIN_EMAIL=mbarutech@gmail.com

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL NOTIFICATIONS (SMTP / Mailer)
# ------------------------------------------------------------------------------

MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="RaphaMIS Notifications <noreply@raphamis.com>"
